# Radarr Configuration (Host network mode)
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_ROOT_FOLDER=/data/movies
DEFAULT_QUALITY_PROFILE_ID=4
DISCORD_CHANNEL=your_discord_channel_id_here

# Kindle / KOReader book push (book_manager.py). Home Wi-Fi only; for pushing from anywhere,
# put Tailscale on the Kindle and use its 100.x address here (see comment in book_manager.py).
KINDLE_HOST=192.168.0.x
KINDLE_PORT=2222
